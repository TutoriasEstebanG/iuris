#!/usr/bin/env python3
"""
Iuris — Pipeline de ingesta del CCyC
SPDX-License-Identifier: AGPL-3.0-or-later

Uso:
    python main.py --solo-validar   # validar el parser (gratis)
    python main.py                  # ingesta completa
"""
import re
import json
import sqlite3
import hashlib
import argparse
from pathlib import Path
from datetime import datetime

import requests
from bs4 import BeautifulSoup

# ═══════════════════════════════════════════════════════
#  CONFIGURACION
# ═══════════════════════════════════════════════════════

BASE = Path(__file__).parent.parent
RAW = BASE / "data" / "raw"
OUT = BASE / "data" / "output"
for d in (RAW, OUT):
    d.mkdir(parents=True, exist_ok=True)

CCYC = {
    "jurisdiccion": "AR",
    "sigla": "CCyC",
    "cuerpo_legal": "Codigo Civil y Comercial de la Nacion",
    "vigente_desde": "2015-08-01",
    "url": ("http://servicios.infoleg.gob.ar/infolegInternet/"
            "anexos/235000-239999/235975/texact.htm"),
    "art_max": 2671,
}

HEADERS = {
    "User-Agent": "Mozilla/5.0 (compatible; IurisIngesta/1.0; academico)",
    "Accept-Language": "es-AR,es;q=0.9",
}

# ═══════════════════════════════════════════════════════
#  PATRONES
# ═══════════════════════════════════════════════════════

ROMANO = r"[IVXLCDM]+"
SUFIJO = r"(?:\s*(?:bis|ter|quater|quinquies|sexies))?"

ORDINALES = "PRIMERO|SEGUNDO|TERCERO|CUARTO|QUINTO|SEXTO|SEPTIMO|OCTAVO"

ORDEN_LIBROS = ["PRIMERO", "SEGUNDO", "TERCERO", "CUARTO",
                "QUINTO", "SEXTO", "SEPTIMO", "OCTAVO"]

P = {
    "libro": re.compile(
        rf"^LIBRO\s+({ORDINALES})\s*[-—–:]?\s*([A-ZÁÉÍÓÚÑ ,]{{0,60}})$"),
    "titulo": re.compile(
        rf"^T[ÍI]TULO\s+(PRELIMINAR|{ROMANO})\s*[-—–:]?\s*([^.]{{0,70}})$"),
    "capitulo": re.compile(
        rf"^CAP[ÍI]TULO\s+(\d+|{ROMANO})\s*[-—–:]?\s*([^.]{{0,70}})$"),
    "seccion": re.compile(
        rf"^SECCI[ÓO]N\s+(\d+|{ROMANO})\s*[ªº°]?\s*[-—–:]?\s*([^.]{{0,70}})$"),
    "articulo": re.compile(
        rf"^ART[ÍI]CULO\s+(\d+\s*[°º]?{SUFIJO})\s*[.,\-—:]\s*(.*)$"),
}

P_REFORMA = re.compile(
    r"\(\s*(?:Art[íi]culo|Inciso)?\s*"
    r"(sustituido|incorporado|derogado|modificado)\s+por\s+"
    r"(?:art\.?\s*[\d°ºbis\s]+\s+de\s+la\s+)?"
    r"(Ley|Decreto)\s*N?[°º]?\s*([\d\.]+)"
    r"[^)]*?(?:B\.?O\.?\s*(\d{1,2}/\d{1,2}/\d{2,4}))?[^)]*\)", re.I)

P_RUBRICA = re.compile(
    r"^\s*[.\-—:]*\s*"
    r"((?:[A-ZÁÉÍÓÚÑ][^.]{2,70}\.\s*){1,3})"
    r"(?=[A-ZÁÉÍÓÚÑ][a-záéíóúñ]|El\s|La\s|Los\s|Las\s|Se\s|Cuando\s|Si\s|En\s|Toda\s|Todo\s|Es\s|Son\s|Puede\s|Debe\s|Hay\s|No\s|Para\s|Sin\s|A\s)"
)

ORDEN = ["libro", "titulo", "capitulo", "seccion"]

# ═══════════════════════════════════════════════════════
#  DESCARGA
# ═══════════════════════════════════════════════════════

def descargar(forzar=False):
    destino = RAW / "ccyc.html"
    if destino.exists() and not forzar:
        print(f"  Usando cache: {destino}")
        return destino.read_bytes()

    print(f"  Descargando desde InfoLeg…")
    r = requests.get(CCYC["url"], headers=HEADERS, timeout=180)
    r.raise_for_status()
    destino.write_bytes(r.content)
    print(f"  ✓ {len(r.content):,} bytes")
    return r.content

# ═══════════════════════════════════════════════════════
#  LIMPIEZA
# ═══════════════════════════════════════════════════════

MOJIBAKE = [
    ("Ã¡","á"), ("Ã©","é"), ("Ã­","í"), ("Ã³","ó"), ("Ãº","ú"),
    ("Ã±","ñ"), ("Ã\x81","Á"), ("Ã‰","É"), ("Ã\x8d","Í"),
    ("Ã“","Ó"), ("Ãš","Ú"), ("Ã‘","Ñ"), ("Â°","°"), ("Âº","º"),
    ("Â¿","¿"), ("Â¡","¡"), ("Â«","«"), ("Â»","»"), ("Â",""),
    ("â€œ",'"'), ("â€\x9d",'"'), ("â€™","'"), ("â€˜","'"),
    ("â€“","-"), ("â€”","—"), ("â€¦","…"),
]

def reparar_mojibake(t: str) -> str:
    for mal, bien in MOJIBAKE:
        if mal in t:
            t = t.replace(mal, bien)
    return t


def limpiar(contenido: bytes) -> str:
    texto = None
    for enc in ("iso-8859-1", "utf-8", "windows-1252"):
        try:
            t = contenido.decode(enc)
            if "ART" in t.upper():
                texto = t
                break
        except UnicodeDecodeError:
            continue
    if texto is None:
        texto = contenido.decode("utf-8", errors="replace")

    soup = BeautifulSoup(texto, "lxml")
    for tag in soup(["script", "style", "noscript", "iframe", "img"]):
        tag.decompose()
    for tag in soup.find_all(["p", "div", "br", "tr", "li"]):
        tag.insert_after("\n")

    t = soup.get_text(separator=" ")

    for a, b in [("\u2013","-"),("\u2014","—"),("\u201c",'"'),
                 ("\u201d",'"'),("\xa0"," "),("\u200b","")]:
        t = t.replace(a, b)

    t = re.sub(r"[ \t]+", " ", t)
    t = re.sub(r"\n[ \t]+", "\n", t)
    t = re.sub(r"\n{3,}", "\n\n", t)
    t = re.sub(r"(ART[ÍI]CULO)\s*\n\s*(\d)", r"\1 \2", t, flags=re.I)
    for e in ("LIBRO","TÍTULO","TITULO","CAPÍTULO","CAPITULO","SECCIÓN","SECCION"):
        t = re.sub(rf"({e})\s*\n\s*([IVXLCDM\d])", r"\1 \2", t, flags=re.I)

    t = reparar_mojibake(t)
    lineas = [l.strip() for l in t.split("\n") if l.strip()]
    return "\n".join(lineas)

# ═══════════════════════════════════════════════════════
#  PARSER
# ═══════════════════════════════════════════════════════

def num_ord(s):
    m = re.match(r"(\d+)", s)
    return int(m.group(1)) if m else 0

def norm_num(s):
    return re.sub(r"\s+", "_", s.strip().lower())

def extraer_reformas(texto):
    refs = []
    for m in P_REFORMA.finditer(texto):
        refs.append({
            "accion": m.group(1).lower(),
            "norma": f"{m.group(2)} {m.group(3)}",
            "bo": m.group(4) or None,
        })
    limpio = re.sub(r"\s{2,}", " ", P_REFORMA.sub("", texto)).strip()
    return limpio, refs

def extraer_rubrica(texto):
    texto = texto.lstrip(" .-—:")
    m = P_RUBRICA.match(texto)
    if not m:
        return "", texto

    r = m.group(1).strip().rstrip(".")
    palabras = r.split()

    if len(palabras) > 14 or len(r) > 120 or len(r) < 4:
        return "", texto

    # Descartar si parece una oracion normativa completa
    if re.search(r"\b(debe|puede|es|son|se|hay|tiene|corresponde)\b",
                 r, re.I) and len(palabras) > 5:
        return "", texto

    resto = texto[m.end():].strip()
    if len(resto) < 20:
        return "", texto

    return r, resto


def extraer_concordancias(texto, propio):
    enc = set()
    for m in re.finditer(r"art[íi]culos?\s+(\d+)", texto, re.I):
        n = m.group(1)
        if n != propio.split()[0]:
            enc.add(n)
    return sorted([c for c in enc if 1 <= int(c) <= CCYC["art_max"]],
                  key=int)[:15]


class Parser:
    def __init__(self):
        self.ctx = {k: "" for k in ORDEN}
        self.arts = []
        self._idx_libro = -1

    def _nivel(self, nivel, num, rot):
        if nivel == "libro":
            n = num.strip().upper()
            if n not in ORDEN_LIBROS:
                return
            idx = ORDEN_LIBROS.index(n)
            self._idx_libro = idx

        self.ctx[nivel] = f"{num.strip()} — {rot.strip()}".strip(" —")
        for inf in ORDEN[ORDEN.index(nivel) + 1:]:
            self.ctx[inf] = ""

    def _cerrar(self, num, buf):
        crudo = re.sub(r"\s{2,}", " ", " ".join(buf).strip())
        if not crudo:
            return

        cuerpo, refs = extraer_reformas(crudo)
        derogado = "derogado" in cuerpo.lower()[:60] or len(cuerpo) < 15
        rub, texto = extraer_rubrica(cuerpo)
        texto = texto or cuerpo
        nn = norm_num(num)

        nuevo_id = f"AR-CCyC-art{nn}"
        if any(a["id"] == nuevo_id for a in self.arts):
            return

        self.arts.append({
            "id": f"AR-CCyC-art{nn}",
            "tipo": "normativo",
            "jurisdiccion": "AR",
            "cuerpo_legal": CCYC["cuerpo_legal"],
            "sigla": "CCyC",
            "libro": self.ctx["libro"],
            "titulo": self.ctx["titulo"],
            "capitulo": self.ctx["capitulo"],
            "seccion": self.ctx["seccion"],
            "articulo": num.strip(),
            "articulo_num": num_ord(num),
            "rubrica": rub,
            "texto": texto,
            "vigente_desde": CCYC["vigente_desde"],
            "vigente_hasta": None,
            "estado": "derogado" if derogado else ("reformado" if refs else "vigente"),
            "jerarquia_normativa": 3,
            "reformas": json.dumps(refs, ensure_ascii=False),
            "concordancias": json.dumps(extraer_concordancias(texto, num)),
            "materia": json.dumps(["civil"]),
            "fuente_url": CCYC["url"],
            "hash_verif": "sha256:" + hashlib.sha256(texto.encode()).hexdigest()[:20],
            "fecha_ingesta": datetime.now().isoformat(),
        })

    def parsear(self, texto):
        # Cortar el indice tematico: arrancar en el Titulo Preliminar real
        ms = list(re.finditer(r"^T[ÍI]TULO\s+PRELIMINAR\s*$", texto, re.M))
        if not ms:
            ms = list(re.finditer(r"^LIBRO\s+PRIMERO\s*$", texto, re.M))
        if ms:
            texto = texto[ms[-1].start():]
        m_fin = re.search(r"^ANEXO\s+II\s*$", texto, re.M)
        if m_fin:
            texto = texto[:m_fin.start()]

        actual, buf = None, []
        for raw in texto.split("\n"):
            l = raw.strip()
            if not l:
                continue

            detectado = None
            for nivel in ORDEN:
                m = P[nivel].match(l)
                if m:
                    detectado = (nivel, m.group(1), m.group(2))
                    break

            if detectado:
                if actual:
                    self._cerrar(actual, buf)
                    actual, buf = None, []
                self._nivel(*detectado)
                continue

            m = P["articulo"].match(l)
            if m:
                if actual:
                    self._cerrar(actual, buf)
                actual = m.group(1)
                buf = [m.group(2).strip()] if m.group(2).strip() else []
                continue

            if actual is not None:
                buf.append(l)

        if actual:
            self._cerrar(actual, buf)

        self.arts.sort(key=lambda a: (a["articulo_num"], a["articulo"]))
        return self.arts

# ═══════════════════════════════════════════════════════
#  VALIDACION
# ═══════════════════════════════════════════════════════

def validar(arts):
    nums = {a["articulo_num"] for a in arts if a["articulo_num"]}
    esperados = set(range(1, CCYC["art_max"] + 1))
    faltantes = sorted(esperados - nums)
    cobertura = len(nums & esperados) / len(esperados)

    ids = [a["id"] for a in arts]
    dups = [i for i in set(ids) if ids.count(i) > 1]
    from collections import Counter
    cnum = Counter(a["articulo_num"] for a in arts if a["articulo_num"])
    dup_num = sorted(n for n, c in cnum.items() if c > 1)
    BIS_OK = {700, 1204, 1221}
    dup_num = [n for n in dup_num if n not in BIS_OK]
    desfasados = []
    for a in arts:
        t = a["texto"].lstrip()
        m = re.match(r"(\d{1,4})[.,]", t)
        if m and abs(int(m.group(1)) - (a["articulo_num"] or 0)) > 50:
            desfasados.append(a["id"])

    sin_libro = [a["id"] for a in arts if not a["libro"]]
    con_rubrica = sum(1 for a in arts if a["rubrica"])

    pat = re.compile(r"\b(LIBRO|T[ÍI]TULO|CAP[ÍI]TULO|SECCI[ÓO]N)\s+"
                     r"(PRIMERO|SEGUNDO|[IVXLCDM]+|\d+)\b")
    contaminados = []
    for a in arts:
        m = pat.search(a["texto"])
        if not m:
            continue
        ini = max(0, m.start() - 100)
        ctx = a["texto"][ini:m.start()].lower()
        # Falso positivo: referencia a otra ley
        if re.search(r"ley\s*n?[°º]?\s*[\d.]+|19\.?550|t\.?o\.?", ctx):
            continue
        contaminados.append(a["id"])

    print()
    print("═" * 62)
    print("  VALIDACION DEL PARSEO")
    print("═" * 62)
    print()
    print(f"  Articulos hallados      {len(arts):>6,}")
    print(f"  Cobertura               {cobertura:>6.2%}")
    print(f"  Faltantes               {len(faltantes):>6}")
    print(f"  Duplicados (id)         {len(dups):>6}")
    print(f"  Duplicados (num)        {len(dup_num):>6}")
    print(f"  Texto desfasado         {len(desfasados):>6}")
    print(f"  Sin libro asignado      {len(sin_libro):>6}")
    print(f"  Con rubrica             {con_rubrica:>6}  ({con_rubrica/max(len(arts),1):.1%})")
    print(f"  Contaminados            {len(contaminados):>6}")
    print()

    errores = []
    if faltantes:
        errores.append(f"{len(faltantes)} faltantes: {faltantes[:10]}")
    if dup_num:
        errores.append(f"numeros duplicados: {dup_num[:10]}")
    if desfasados:
        errores.append(f"{len(desfasados)} con texto desfasado: {desfasados[:5]}")
    if cobertura < 1.0:
        errores.append(f"Cobertura {cobertura:.2%} < 100%")
    if dups:
        errores.append(f"IDs duplicados: {dups[:5]}")
    if len(sin_libro) > 50:
        errores.append(f"{len(sin_libro)} articulos sin jerarquia")
    if contaminados:
        errores.append(f"{len(contaminados)} articulos contaminados")

    if errores:
        print("  ⛔ ERRORES:")
        for e in errores:
            print(f"     · {e}")
        print()
        print("═" * 62)
        print("  RESULTADO: NO APTO — ajustar el parser")
        print("═" * 62)
        return False

    if faltantes:
        print(f"  ⚠ {len(faltantes)} articulos ausentes "
              f"(posibles derogaciones): {faltantes[:12]}")
        print()

    print("═" * 62)
    print("  RESULTADO: ✅ APTO PARA CARGA")
    print("═" * 62)
    return True

# ═══════════════════════════════════════════════════════
#  CARGA
# ═══════════════════════════════════════════════════════

def cargar(arts):
    db = OUT / "iuris.db"
    if db.exists():
        db.unlink()

    con = sqlite3.connect(db)
    con.executescript((Path(__file__).parent / "schema.sql")
                      .read_text(encoding="utf-8"))

    cols = list(arts[0].keys())
    ph = ",".join("?" * len(cols))
    sql = f"INSERT INTO normas ({','.join(cols)}) VALUES ({ph})"

    for a in arts:
        con.execute(sql, tuple(a.values()))
        ubic = " › ".join(x for x in [a["libro"], a["titulo"],
                                       a["capitulo"], a["seccion"]] if x)
        con.execute(
            "INSERT INTO normas_fts (id,cuerpo_legal,ubicacion,rubrica,texto,materia) "
            "VALUES (?,?,?,?,?,?)",
            (a["id"], a["cuerpo_legal"], ubic, a["rubrica"], a["texto"], "civil"))

    con.commit()
    con.execute("ANALYZE")
    con.close()

    mb = db.stat().st_size / 1024 / 1024
    print(f"\n  ✓ Base creada: {db} ({mb:.1f} MB)")

    # Verificacion
    con = sqlite3.connect(db)
    con.row_factory = sqlite3.Row
    print("\n  Verificacion:")
    for aid in ("AR-CCyC-art1", "AR-CCyC-art387", "AR-CCyC-art1757"):
        r = con.execute("SELECT * FROM normas WHERE id=?", (aid,)).fetchone()
        if r:
            print(f"    ✓ {aid} — {r['rubrica'] or '(sin rubrica)'}")
            print(f"        «{r['texto'][:90]}…»")
        else:
            print(f"    ✗ {aid} no encontrado")

    fts = con.execute(
        'SELECT id FROM normas_fts WHERE normas_fts MATCH ? LIMIT 3',
        ('"nulidad absoluta"',)).fetchall()
    print(f"\n    FTS «nulidad absoluta» → {[f['id'] for f in fts]}")
    con.close()

# ═══════════════════════════════════════════════════════
#  MAIN
# ═══════════════════════════════════════════════════════

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--solo-validar", action="store_true")
    ap.add_argument("--forzar-descarga", action="store_true")
    args = ap.parse_args()

    print("╔" + "═" * 60 + "╗")
    print("║  INGESTA DEL CODIGO CIVIL Y COMERCIAL                      ║")
    print("╚" + "═" * 60 + "╝")

    print("\n[1/4] Descarga")
    contenido = descargar(args.forzar_descarga)

    print("\n[2/4] Limpieza")
    texto = limpiar(contenido)
    print(f"  ✓ {len(texto):,} caracteres, {texto.count(chr(10)):,} lineas")

    print("\n[3/4] Parseo")
    arts = Parser().parsear(texto)
    print(f"  ✓ {len(arts):,} articulos")

    print("\n[4/4] Validacion")
    if not validar(arts):
        raise SystemExit(1)

    # Volcado JSON para inspeccion manual
    (OUT / "articulos.json").write_text(
        json.dumps(arts, ensure_ascii=False, indent=1), encoding="utf-8")
    print(f"\n  Volcado: {OUT / 'articulos.json'}")

    if args.solo_validar:
        print("\n✓ Solo validacion (--solo-validar)")
        print("\n  Antes de continuar, verifica manualmente 20 articulos")
        print("  contra InfoLeg. Los tests no reemplazan esa lectura.")
        return

    print("\n[Carga en SQLite]")
    cargar(arts)

    print("\n" + "═" * 62)
    print("  ✅ INGESTA COMPLETADA")
    print("═" * 62)
    print(f"\n  Articulos: {len(arts):,}")
    print(f"  Base:      {OUT / 'iuris.db'}")
    print("\n  Ahora podes levantar el servidor:")
    print("    cd .. && ./scripts/dev.sh")
    print()


if __name__ == "__main__":
    main()

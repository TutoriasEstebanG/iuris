#!/usr/bin/env python3
"""Ingesta de la Constitucion Nacional Argentina (Ley 24.430).

Fuente: InfoLeg, encoding ISO-8859-1.
Estructura: Parte -> Titulo -> Seccion -> Capitulo.
La Primera Parte solo tiene Capitulos (sin Titulo ni Seccion).

Notas sobre erratas del texto oficial:
  - La transitoria 11 figura como "Undecimo" (masculino) en el original.
  - Los encabezados alternan mayusculas/capitalizado y con/sin tilde.
"""
import re
import json
import hashlib
import pathlib
import argparse
from datetime import datetime
from collections import Counter

import requests
from bs4 import BeautifulSoup

RAIZ = pathlib.Path(__file__).resolve().parent.parent
RAW = RAIZ / "data" / "raw" / "cn.html"
OUT = RAIZ / "data" / "output"

CN = {
    "jurisdiccion": "AR",
    "sigla": "CN",
    "cuerpo_legal": "Constitucion de la Nacion Argentina",
    "vigente_desde": "1994-08-24",
    "url": ("http://servicios.infoleg.gob.ar/infolegInternet/"
            "anexos/0-4999/804/norma.htm"),
    "art_max": 129,
    "jerarquia": 1,
    "materia": ["constitucional"],
}

HEADERS = {
    "User-Agent": "Mozilla/5.0 (compatible; IurisIngesta/1.0; academico)",
    "Accept-Language": "es-AR,es;q=0.9",
}

TRANSITORIAS = [
    "Primera", "Segunda", "Tercera", "Cuarta", "Quinta", "Sexta",
    "Septima", "Octava", "Novena", "Decima", "Undecimo", "Duodecima",
    "Decimotercera", "Decimocuarta", "Decimoquinta", "Decimosexta",
    "Decimoseptima",
]

ORDINAL_PAT = ("PRIMER[OA]|SEGUND[OA]|TERCER[OA]|CUART[OA]|QUINT[OA]|"
               "SEXT[OA]|SEPTIM[OA]|OCTAV[OA]|NOVEN[OA]|DECIM[OA]")

P = {
    "parte": re.compile(r"^(PRIMERA|SEGUNDA)\s+PARTE$", re.I),
    "titulo": re.compile(rf"^T[ÍI]TULO\s+({ORDINAL_PAT})$", re.I),
    "seccion": re.compile(rf"^SECCI[ÓO]N\s+({ORDINAL_PAT})$", re.I),
    "capitulo": re.compile(rf"^CAP[ÍI]TULO\s+({ORDINAL_PAT})$", re.I),
    "articulo": re.compile(r"^Art[íi]culo\s+(\d+)\s*[ºo°]?\s*\.?\s*-\s*(.*)$"),
}

_ORD_T = ("Primera|Segunda|Tercera|Cuarta|Quinta|Sexta|S[eé]ptima|Octava|"
          "Novena|D[eé]cima|Und[eé]cim[oa]|Duod[eé]cima|Decimotercera|"
          "Decimocuarta|Decimoquinta|Decimosexta|Decimos[eé]ptima")
P_TRANS = re.compile(rf"^({_ORD_T})\s*\.\s*(.*)$", re.I)

P_CORRESP = re.compile(r"\(Corresponde a\s*(?:los\s*)?(?:l[oa]s\s*)?"
                       r"[Aa]rt[íi]?c?u?l?o?s?\.?\s*([^)]+)\)")

ORDEN = ["parte", "titulo", "seccion", "capitulo"]


def descargar(forzar=False):
    if RAW.exists() and not forzar:
        print(f"  Usando cache: {RAW}")
        return RAW.read_bytes()
    print(f"  Descargando {CN['url']}")
    r = requests.get(CN["url"], headers=HEADERS, timeout=180)
    r.raise_for_status()
    RAW.parent.mkdir(parents=True, exist_ok=True)
    RAW.write_bytes(r.content)
    print(f"  Guardado: {len(r.content):,} bytes")
    return r.content


def limpiar(contenido: bytes) -> list:
    texto = None
    for enc in ("iso-8859-1", "utf-8", "windows-1252"):
        try:
            t = contenido.decode(enc)
            if "Art" in t:
                texto = t
                break
        except UnicodeDecodeError:
            continue
    if texto is None:
        texto = contenido.decode("utf-8", errors="replace")

    soup = BeautifulSoup(texto, "lxml")
    for tag in soup(["script", "style", "noscript", "iframe", "img"]):
        tag.decompose()
    for tag in soup.find_all(["p", "div", "br", "tr", "li"]):
        tag.insert_after("\n")

    t = soup.get_text(separator=" ")
    for a, b in [("\u2013", "-"), ("\u2014", "-"), ("\u201c", '"'),
                 ("\u201d", '"'), ("\xa0", " "), ("\u200b", "")]:
        t = t.replace(a, b)
    t = re.sub(r"[ \t]+", " ", t)
    return [l.strip() for l in t.split("\n") if l.strip()]


def acotar(lineas):
    """Recorta el envoltorio de la ley 24.430."""
    ini = next((i for i, l in enumerate(lineas)
                if l.upper().startswith("PRE") and "MBULO" in l.upper()), None)
    if ini is None:
        raise SystemExit("ERROR: no encontre el PREAMBULO")
    fin = next((i for i, l in enumerate(lineas[ini:], start=ini)
                if re.match(r"^ARTICULO\s+2", l)), len(lineas))
    print(f"  Corpus: lineas {ini}-{fin} ({fin - ini})")
    return lineas[ini:fin]


# ═══════════════════════════════════════════════════════
#  PARSER
# ═══════════════════════════════════════════════════════

class ParserCN:
    def __init__(self):
        self.ctx = {k: "" for k in ORDEN}
        self.arts = []

    def _nivel(self, nivel, rot):
        self.ctx[nivel] = rot.strip()
        for inf in ORDEN[ORDEN.index(nivel) + 1:]:
            self.ctx[inf] = ""

    def _guardar(self, clave, num, buf, es_trans=False):
        texto = re.sub(r"\s{2,}", " ", " ".join(buf).strip())
        if not texto:
            return
        corresp = []
        for m in P_CORRESP.finditer(texto):
            corresp += re.findall(r"\d+", m.group(1))
        texto = P_CORRESP.sub("", texto).strip()
        texto = re.sub(r"\s{2,}", " ", texto)

        if es_trans:
            art_id = f"AR-CN-trans{num}"
            etiqueta = f"Disposicion transitoria {clave}"
        elif num == 0:
            art_id = "AR-CN-preambulo"
            etiqueta = "Preambulo"
        else:
            art_id = f"AR-CN-art{num}"
            etiqueta = str(num)

        self.arts.append({
            "id": art_id,
            "tipo": "normativo",
            "jurisdiccion": CN["jurisdiccion"],
            "cuerpo_legal": CN["cuerpo_legal"],
            "sigla": CN["sigla"],
            "libro": self.ctx["parte"],
            "titulo": self.ctx["titulo"],
            "capitulo": self.ctx["capitulo"],
            "seccion": self.ctx["seccion"],
            "articulo": etiqueta,
            "articulo_num": num,
            "rubrica": "",
            "texto": texto,
            "vigente_desde": CN["vigente_desde"],
            "vigente_hasta": None,
            "estado": "vigente",
            "jerarquia_normativa": CN["jerarquia"],
            "reformas": "[]",
            "concordancias": json.dumps(sorted(set(corresp)), ensure_ascii=False),
            "materia": json.dumps(CN["materia"], ensure_ascii=False),
            "fuente_url": CN["url"],
            "hash_verif": "sha256:" + hashlib.sha256(texto.encode()).hexdigest()[:20],
            "fecha_ingesta": datetime.now().isoformat(),
        })

    def parsear(self, lineas):
        modo = "preambulo"
        clave, num, buf = "Preambulo", 0, []
        n_trans = 0

        for l in lineas:
            if l.upper().startswith("PRE") and "MBULO" in l.upper():
                continue

            if re.match(r"^DISPOSICIONES\s+TRANSITORIAS", l, re.I):
                if buf:
                    self._guardar(clave, num, buf, modo == "trans")
                    buf = []
                modo = "trans"
                continue

            det = None
            for niv in ORDEN:
                m = P[niv].match(l)
                if m:
                    det = (niv, l)
                    break
            if det:
                if modo == "preambulo" and buf:
                    self._guardar(clave, num, buf, False)
                    buf = []
                    modo = "art"
                self._nivel(det[0], det[1])
                self._pend_rot = det[0]
                continue

            if getattr(self, "_pend_rot", None):
                niv = self._pend_rot
                self._pend_rot = None
                if not P["articulo"].match(l) and not P_TRANS.match(l) \
                        and len(l) < 90:
                    self.ctx[niv] = f"{self.ctx[niv]} - {l}"
                    continue

            if modo == "trans":
                m = P_TRANS.match(l)
                if m:
                    if buf:
                        self._guardar(clave, num, buf, True)
                    n_trans += 1
                    clave, num = m.group(1), 1000 + n_trans
                    buf = [m.group(2).strip()] if m.group(2).strip() else []
                    continue
            else:
                m = P["articulo"].match(l)
                if m:
                    if buf:
                        self._guardar(clave, num, buf, False)
                    modo = "art"
                    clave, num = m.group(1), int(m.group(1))
                    buf = [m.group(2).strip()] if m.group(2).strip() else []
                    continue

            buf.append(l)

        if buf:
            self._guardar(clave, num, buf, modo == "trans")

        self.arts.sort(key=lambda a: a["articulo_num"])
        return self.arts


# ═══════════════════════════════════════════════════════
#  VALIDACION
# ═══════════════════════════════════════════════════════

def validar(arts):
    nums = [a["articulo_num"] for a in arts]
    body = {n for n in nums if 1 <= n <= CN["art_max"]}
    faltan = sorted(set(range(1, CN["art_max"] + 1)) - body)
    dups = sorted(n for n, c in Counter(nums).items() if c > 1)
    trans = [a for a in arts if a["articulo_num"] > 1000]
    preamb = [a for a in arts if a["articulo_num"] == 0]
    sin_parte = [a["id"] for a in arts if not a["libro"]
                 and a["articulo_num"] not in (0,) and a["articulo_num"] < 1000]
    cortos = [a["id"] for a in arts if len(a["texto"]) < 40
              and a["articulo_num"] < 1000]

    print()
    print("=" * 62)
    print("  VALIDACION CN")
    print("=" * 62)
    print(f"  Articulos (1-129)      {len(body):>6}")
    print(f"  Faltantes              {len(faltan):>6}  {faltan[:10]}")
    print(f"  Duplicados             {len(dups):>6}  {dups[:10]}")
    print(f"  Preambulo              {len(preamb):>6}")
    print(f"  Transitorias           {len(trans):>6}  (esperado 17)")
    print(f"  Sin Parte asignada     {len(sin_parte):>6}")
    print(f"  Textos < 40 chars      {len(cortos):>6}  {cortos[:5]}")
    print()

    err = []
    if faltan:
        err.append(f"faltan {len(faltan)} articulos")
    if dups:
        err.append(f"duplicados: {dups[:5]}")
    if len(preamb) != 1:
        err.append(f"preambulo: {len(preamb)} (esperado 1)")
    if len(trans) != 17:
        err.append(f"transitorias: {len(trans)} (esperado 17)")
    if sin_parte:
        err.append(f"{len(sin_parte)} sin Parte")
    if cortos:
        err.append(f"{len(cortos)} textos sospechosamente cortos")

    if err:
        print("  RESULTADO: NO APTO")
        for e in err:
            print(f"    - {e}")
    else:
        print("  RESULTADO: APTO PARA CARGA")
    print("=" * 62)
    return not err


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--forzar-descarga", action="store_true")
    ap.add_argument("--solo-validar", action="store_true")
    a = ap.parse_args()

    print("=" * 62)
    print("  INGESTA DE LA CONSTITUCION NACIONAL")
    print("=" * 62)
    print("\n[1/4] Descarga")
    crudo = descargar(a.forzar_descarga)
    print("\n[2/4] Limpieza")
    lineas = acotar(limpiar(crudo))
    print("\n[3/4] Parseo")
    arts = ParserCN().parsear(lineas)
    print(f"  {len(arts)} unidades")
    print("\n[4/4] Validacion")
    ok = validar(arts)

    OUT.mkdir(parents=True, exist_ok=True)
    destino = OUT / "cn.json"
    destino.write_text(json.dumps(arts, ensure_ascii=False, indent=1),
                       encoding="utf-8")
    print(f"\n  Volcado: {destino}")
    if not ok:
        print("  (revisar antes de cargar a la base)")


if __name__ == "__main__":
    main()

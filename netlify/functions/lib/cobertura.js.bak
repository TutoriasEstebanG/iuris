/**
 * Iuris — Guardrail de cobertura normativa
 * Detecta consultas sobre ramas del derecho ausentes del corpus.
 * SPDX-License-Identifier: AGPL-3.0-or-later
 */

// Ramas efectivamente cargadas en la base
export const CUBIERTO = {
  civil: ["CCyC"],
  comercial: ["CCyC"],
  constitucional: ["CN"],
};

// Terminos que delatan una rama SIN corpus
const AUSENTES = {
  laboral: {
    rx: /\b(trabajador(?:es|a)?|laboral(?:es)?|despido|indemnizaci[óo]n por despido|salario|sindical|sindicato|huelga|jornada laboral|LCT|20\.?744|convenio colectivo|obra social|ART|riesgos del trabajo|aguinaldo|vacaciones pagas)\b/i,
    norma: "Ley de Contrato de Trabajo 20.744, leyes sindicales y de riesgos del trabajo",
  },
  penal: {
    rx: /\b(delito|delictiv|tipo penal|imputad|querella|excarcelaci[óo]n|prisi[óo]n preventiva|c[óo]digo penal|dolo eventual|culpabilidad|pena privativa)\b/i,
    norma: "Codigo Penal (Ley 11.179)",
  },
  procesal: {
    rx: /\b(c[óo]digo procesal|CPCC|CPCCN|CPPF|contestar la demanda|traslado de la demanda|excepciones previas|recurso de apelaci[óo]n|caducidad de instancia|prueba pericial|alegato)\b/i,
    norma: "codigos procesales (CPCCN, CPCCBA, CPP segun jurisdiccion)",
  },
  administrativo: {
    rx: /\b(acto administrativo|procedimiento administrativo|19\.?549|LNPA|recurso jer[áa]rquico|contencioso administrativo|empleo p[úu]blico)\b/i,
    norma: "Ley 19.549 de Procedimientos Administrativos y normas locales",
  },
  tributario: {
    rx: /\b(tributari|impuesto a las ganancias|IVA|AFIP|ARCA|determinaci[óo]n de oficio|11\.?683)\b/i,
    norma: "Ley 11.683 y leyes impositivas",
  },
  consumo_especial: {
    rx: /\b(24\.?240|ley de defensa del consumidor)\b/i,
    norma: "Ley 24.240 (el CCyC regula la materia en los arts. 1092-1122)",
  },
};

/**
 * @param {string} consulta
 * @returns {{ramas: string[], aviso: string|null}}
 */
export function evaluarCobertura(consulta) {
  const ramas = [];
  const faltantes = [];
  for (const [rama, def] of Object.entries(AUSENTES)) {
    if (def.rx.test(consulta)) {
      ramas.push(rama);
      faltantes.push(`${rama} (${def.norma})`);
    }
  }
  if (!ramas.length) return { ramas: [], aviso: null };

  const aviso =
    `\n\n## LIMITACION DE CORPUS — INSTRUCCION OBLIGATORIA\n` +
    `La consulta involucra: ${faltantes.join("; ")}.\n` +
    `El corpus cargado contiene UNICAMENTE el Codigo Civil y Comercial y la ` +
    `Constitucion Nacional. No tenes esa normativa a la vista.\n` +
    `Debes:\n` +
    `1. Abrir la respuesta advirtiendo de forma destacada que no dispones de ` +
    `las fuentes de esa rama y que lo que sigue no esta anclado normativamente.\n` +
    `2. Indicar que norma habria que consultar.\n` +
    `3. NO enunciar plazos, montos, porcentajes ni requisitos concretos como ` +
    `si fueran verificados. Si los mencionas, marcalos expresamente como ` +
    `orientativos y sujetos a verificacion en la fuente.\n` +
    `4. Limitarte al encuadre conceptual y a lo que SI surge del CCyC o la CN.\n` +
    `5. No producir un desarrollo extenso que simule respaldo normativo inexistente.\n`;

  return { ramas, aviso };
}
